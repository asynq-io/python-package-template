{%- set python_versions = ["3.9", "3.10", "3.11", "3.12", "3.13", "3.14"] -%}
{%- set supported_versions = python_versions[python_versions.index(python_version):] -%}
[project]
name = "{{ package_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }},<4.0"
license = "Apache-2.0"
keywords = []
authors = []
classifiers = [
    "Development Status :: 4 - Beta",
    "Intended Audience :: Developers",
    "Operating System :: OS Independent",
    "Programming Language :: Python",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3 :: Only",
{%- for version in supported_versions %}
    "Programming Language :: Python :: {{ version }}",
{%- endfor %}
    "Programming Language :: Python :: Implementation :: CPython",
    "Programming Language :: Python :: Implementation :: PyPy",
    "Topic :: Software Development :: Libraries",
    "Topic :: Software Development :: Libraries :: Python Modules",
    "Typing :: Typed",
]
dependencies = []

[project.urls]
Documentation = "https://github.com/{{ owner }}/{{ package_name }}#readme"
Issues = "https://github.com/{{ owner }}/{{ package_name }}/issues"
Source = "https://github.com/{{ owner }}/{{ package_name }}"

[dependency-groups]
dev = [
    {include-group = "lint"},
    {include-group = "test"},
    {include-group = "docs"},
    "ipython",
]

test = [
    "pytest",
    "pytest-cov",
    "pytest-sugar",
    "pytest-repeat",
    "pytest-timeout",
]

lint = [
    "mypy",
    "ruff",
    "bandit",
]

docs = [
    "mkdocs",
    "mkdocs-material",
    "mkdocs-autorefs",
    "mkdocstrings[python]",
    "watchdog",
]

[tool.uv.build-backend]
module-root = ""
module-name = "{{ package_dir }}"

[build-system]
requires = ["uv_build>=0.9.16,<0.10.0"]
build-backend = "uv_build"

[tool.pytest.ini_options]
timeout = 3
addopts = "--cov=./{{ package_dir }}"
testpaths = ["./tests"]

[tool.coverage.report]
exclude_lines = [
    "pragma: no cover",
    "if TYPE_CHECKING:",
    "raise NotImplementedError",
    "except ImportError:"
]

[tool.pyright]
venvPath = "."
venv = ".venv"

[tool.mypy]
python_version = "{{ python_version }}"
exclude = [".venv", "^tmp/"]
{% if strict_mypy %}strict = true
{% else %}disallow_untyped_defs = false
disallow_incomplete_defs = false
{% endif -%}
disable_error_code = ["annotation-unchecked"]
follow_imports = "normal"
ignore_missing_imports = true
pretty = true
show_column_numbers = true
show_error_codes = true
warn_no_return = false
warn_unused_ignores = true

[tool.ruff]
target-version = "py{{ python_version | replace('.', '') }}"

line-length = 88
indent-width = 4

[tool.ruff.lint]
select = ["ALL"]

ignore = [
    "A002",
    "ANN401",
    "B008",     # do not perform function calls in argument defaults
    "COM812",
    "CPY001",
    "D",
    "E501",     # line too long
    "EM101",
    "N818",
    "PLW2901",
    "PTH123",
    "TRY003",
]

[tool.ruff.lint.per-file-ignores]
"tests/*" = ["S101", "ANN001", "ANN002", "ANN003", "ANN201", "ANN202", "SLF001", "PLR2004", "ARG002", "FBT001"]
"examples/*" = ["S101", "ANN001", "ANN201", "INP001", "T201", "EM101", "TRY003"]
"{{ package_dir }}/*" = ["PLC0415"]

[tool.bandit]
skips = ['B101']
